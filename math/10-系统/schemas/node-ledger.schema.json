{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BYG Math Node Ledger",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "state", "evidence", "coverage_note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[GLP][0-9]+\\.[0-9]{2}$"},
          "name": {"type": "string"},
          "state": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "coverage_note": {"type": "string"}
        }
      }
    }
  }
}
